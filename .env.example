# 本番はVercelダッシュボードで設定します。すべてサーバー専用です。
# デモには環境変数は不要。以下が不足している間、訪問者の実サイト診断は無効です。
# GitHub OAuth Appはログイン専用で新規作成し、リポジトリアクセスを許可しません。
# Callback URL: <APP_ORIGIN>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 32文字以上の十分にランダムな値。ADMIN_PASSWORDとは別の値を使用。
SESSION_SECRET=
# 本番は https://your-project.vercel.app （パス・クエリなし）
# 開発者がローカルでOAuthを確認する場合のみ http://localhost:3000
APP_ORIGIN=
# Private Blobを接続。VercelではBLOB_STORE_IDと自動OIDC認証を利用できます。
BLOB_STORE_ID=
# OIDCを使わない場合のみ読み書きトークンを設定。手動でOIDCトークンを保存しません。
BLOB_READ_WRITE_TOKEN=
# 任意：運営者専用の旧許可リストを使う場合だけ32文字以上のランダム値を設定。
ADMIN_PASSWORD=
# NEXT_PUBLIC_は付けないでください。Previewに本番の秘密情報やストアを共有しません。
# 旧ALLOWED_HOSTSは使用しません。
